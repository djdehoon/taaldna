# TaalDNA — example environment variables
#
# Local development:
#   Copy this file to `.env.local` and fill in real values (`.env.local` is gitignored).
#
# Vercel:
#   Project → Settings → Environment Variables → add the same keys for Production
#   (and Preview if you use Supabase there).

# Supabase (browser — anon key only in NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role: server-only. Dashboard → Project Settings → API → service_role.
# Used by /api/send-report to insert into taaldna_leads. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend transactional email: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Optional: override From header (must be a verified domain in Resend).
# RESEND_FROM=TaalDNA <noreply@yourdomain.com>

# Public site URL for links in emails (CTA naar /resultaat). On Vercel you can omit if VERCEL_URL is set.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://taaldna.vercel.app
